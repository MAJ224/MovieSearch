{
  "Providers": {
    "Omdb": {
      "BaseUrl": "https://www.Omdbapi.com/"
    }
  },
  "RateLimiting": {
    "Api": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
